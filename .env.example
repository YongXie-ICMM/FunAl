# Copy this file to .env (which is git-ignored) and fill in your own key.
# The key is read ONLY by mentor_server.py on your machine. It never reaches the browser or the repo.
KIMI_API_KEY=sk-your-moonshot-key-here
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6   # any chat model your key can use; the server falls back automatically if this one is unavailable
